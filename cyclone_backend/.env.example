# ==============================================================================
# CYCLONE WATCH - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' in the 'cyclone_backend' directory:
#   cp .env.example .env
#
# NOTE: The platform runs fully out-of-the-box in simulated/cached mode even without
# live MOSDAC credentials. Adding valid credentials activates real-time ISRO telemetry.
# ==============================================================================

# Database Connection (Default: SQLite local development database)
DATABASE_URL="sqlite:///cyclone.db"

# Server Host & Port
PORT=8000
HOST="0.0.0.0"

# ISRO MOSDAC Satellite Ingestion Configuration
# Free registration at https://www.mosdac.gov.in/ (Meteorological & Oceanographic Satellite Data Archival Centre)
MOSDAC_USERNAME="your_mosdac_username"
MOSDAC_PASSWORD="your_mosdac_password"
MOSDAC_FTP_HOST="ftp.mosdac.gov.in"
MOSDAC_HTTP_PORTAL="https://www.mosdac.gov.in"
MOSDAC_DEFAULT_PRODUCT="3D_IMG_L1C_ASIA_MER"
MOSDAC_AUTO_SYNC_MINUTES=30
